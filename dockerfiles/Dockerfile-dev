# syntax=docker/dockerfile:1.28.0@sha256:bb22d9815c728170f72750f4e5b0d672e06176142e1d602c7e66c050100b7e5b
#=======================
FROM ghcr.io/astral-sh/uv:0.12.5-python3.14-trixie-slim@sha256:dc360d7e5f968c682e8b59e83027a315a0232dead15cb9dfe3e707a12ba390e1 AS base
#=======================

RUN apt-get update \
    && apt-get install -y ca-certificates git curl

WORKDIR /app

# Copy uv files
COPY pyproject.toml .
COPY uv.lock .
COPY .python-version .
COPY uv-artifactory.sh .

# Copy project files
COPY README.md .
COPY metadata_backend ./metadata_backend
COPY private/private_jwks.json ./private/private_jwks.json

# Install dependencies and create virtual environment
RUN --mount=type=secret,id=vault_secrets \
    ./uv-artifactory.sh uv sync --dev

# Use virtual environment by default
ENV PATH="/app/.venv/bin:$PATH"

#=======================
FROM base AS test
#=======================

# Copy test files so tests can be run in the dev container
COPY tests ./tests
COPY .pytest.ini .
COPY uv-artifactory.sh /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
